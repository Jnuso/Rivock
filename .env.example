# Local Docker Compose only. Never reuse these database credentials in Azure.
POSTGRES_USER=rivock
POSTGRES_PASSWORD=rivock_local
POSTGRES_DB=rivock
ENVIRONMENT=local
MODERATION_MODE=off
RATE_HMAC_SECRET=local-only-change-before-deployment
VITE_API_URL=http://localhost:8000/api/v1
AI_MODEL=
AI_API_KEY=
AI_BILLING_MODE=metered
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
# Clerk Frontend API origin; no trailing slash. See docs/CLERK_SETUP.md.
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
# Optional only if you customize the session token aud claim.
CLERK_AUDIENCE=
# Public key only; never a Clerk secret key.
VITE_CLERK_PUBLISHABLE_KEY=
