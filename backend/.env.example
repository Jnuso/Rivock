ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://rivock:rivock_local@127.0.0.1:5432/rivock
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# pending is safe without a provider. fixture is explicitly local/test only.
MODERATION_MODE=off
AI_MODEL=
AI_API_KEY=
# free is opt-in for the verified Gemma model with both prices exactly zero.
AI_BILLING_MODE=metered
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
AI_MAX_INPUT_TOKENS=16000
AI_MAX_OUTPUT_TOKENS=256
AI_MONTHLY_BUDGET_USD=2
AI_DAILY_CALL_CAP=100
AI_PAUSED=false
RATE_HMAC_SECRET=local-only-change-before-deployment
TRUSTED_PROXY_IPS=
# Clerk Frontend API origin; no trailing slash. See docs/CLERK_SETUP.md.
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
# Optional only if you customize the session token aud claim.
CLERK_AUDIENCE=
